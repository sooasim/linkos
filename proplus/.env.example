# PROPLUS 환경변수 예시 — proplus/.env 로 복사해 쓴다 (.env 는 절대 커밋하지 않는다, P-191).
# 운영 서버에서는 이 파일이 아니라 /etc/proplus/proplus.env (root:proplus 640) 가 쓰인다.
# LINKOS 의 .env 와 **섞지 않는다** — DB·쿠키·스토리지·비밀키를 공유하지 않는다 (전략 §1).
# 비밀값은 이 파일에 적지 않는다. 서버에서 생성해 밖으로 내보내지 않는다.

# proplus 데이터베이스. 포트 5433 은 proplus/infra/docker-compose.yml 의 로컬 DB 다(LINKOS 는 5432).
DATABASE_URL=postgres://proplus:proplus@localhost:5433/proplus
# 공개 프로필 링크·vCard·메일 본문에 박히는 절대 주소. 운영은 https://proplus.linkos.com
APP_ORIGIN=http://localhost:4400
# 세션 쿠키(pp_session)·HMAC 서명 키. 32바이트 이상 랜덤: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# 컬럼 단위 암호화 키(AES-256-GCM). lead_contacts 같은 고객 PII 를 저장 시 암호화한다 (데이터모델 §4.1). openssl rand -base64 32
FIELD_KEY=
# 알림·검증 결과 메일 발송. 비어 있으면 발송하지 않고 로그로만 남긴다(개발 기본값).
SMTP_URL=
# 증거 원본·프로필 미디어 로컬 저장 경로. 운영은 /var/lib/proplus/storage (N-5: 공개 경로와 분리)
OBJECT_STORAGE_LOCAL_DIR=./.data/proplus-objects
# 증거 파일 다운로드용 단기 signed URL 서명 키. AUTH_SECRET 과 분리한다 — URL 서명이 유출돼도 세션은 안전해야 한다 (보안정책 §2 증빙 파일 유출). openssl rand -base64 32
STORAGE_SIGNING_KEY=
# 웹/API 포트. 운영은 4400 (LINKOS 4300 과 겹치지 않는다). 운영 유닛은 이 값을 유닛에서 다시 못 박는다.
PORT=4400

# 동의·검증 기록에 함께 남길 정책 버전 (N-11 / policy_versions 테이블의 PK 와 일치해야 한다).
# 기본값은 0001 마이그레이션이 시드한 값이다. 법률검토가 끝나면 새 버전을 INSERT 하고 여기만 바꾼다.
POLICY_VERSION_PRIVACY=privacy-2026-10-22
POLICY_VERSION_TERMS=terms-2026-10-22
POLICY_VERSION_VERIFICATION=verification-2026-10-22
POLICY_VERSION_CANCELLATION=cancellation-2026-10-22

# 1 = /login 에 "테스트 계정으로 바로 시작"(일회용 계정, 메일 불필요). 테스트 서버 전용 — 운영에서는 비워 둔다.
DEMO_LOGIN=
