# Copy to .env (never commit .env)
DATABASE_URL=postgres://linkos:linkos@localhost:5432/linkos
# Public origin used for exchange links (https in production)
APP_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. Used for session cookies/HMAC.
AUTH_SECRET=change-me-to-a-long-random-string
# Email OTP delivery. If unset in non-production, OTP codes are logged to the server console.
SMTP_URL=
MAIL_FROM="LINKOS <no-reply@linkos.app>"
# Google OAuth (Sign-in + People API sync). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key (base64) for encrypting integration credentials at rest
CREDENTIALS_KEY=
# (also the key-encryption key that wraps the per-object keys of stored files — F-019)

# --- Encrypted object storage (card originals, profile media, room files, recordings) ---
# Default: local encrypted disk at ./.data/objects. Set OBJECT_STORAGE_BUCKET (or DRIVER=s3) for S3-compatible storage.
OBJECT_STORAGE_DRIVER=
OBJECT_STORAGE_LOCAL_DIR=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_PREFIX=
CARD_IMAGE_RETENTION_DAYS=365
RECORDING_RETENTION_DAYS=180
# --- Upload malware scan (F-172): optional clamd (INSTREAM over TCP) ---
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# 1 = reject uploads when the scanner is unavailable (fail closed)
CLAMAV_REQUIRED=
# --- Meeting transcription (F-082/F-083): google | whisper (empty = store recordings without STT) ---
STT_PROVIDER=
STT_LANGUAGES=ko-KR,en-US
STT_MAX_SPEAKERS=6
STT_TIMEOUT_MS=120000
GOOGLE_STT_PROJECT=
GOOGLE_STT_LOCATION=global
GOOGLE_STT_MODEL=long
GOOGLE_STT_RECOGNIZER=_
# one of: service-account JSON, OAuth access token, API key
GOOGLE_STT_CREDENTIALS_JSON=
GOOGLE_STT_ACCESS_TOKEN=
GOOGLE_STT_API_KEY=
GOOGLE_STT_ENDPOINT=
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
STT_LANGUAGE=
