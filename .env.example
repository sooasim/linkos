# Copy to .env (never commit .env)
DATABASE_URL=postgres://linkos:linkos@localhost:5432/linkos
# Public origin used for exchange links (https in production)
APP_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. Used for session cookies/HMAC.
AUTH_SECRET=change-me-to-a-long-random-string
# Email OTP delivery. If unset in non-production, OTP codes are logged to the server console.
SMTP_URL=
MAIL_FROM="LINKOS <no-reply@linkos.app>"
# Google OAuth (Sign-in + People API sync). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple (web, F-001/F-060). Optional — the "Apple로 계속" button appears only when all four are set.
# APPLE_CLIENT_ID = Services ID (e.g. com.linkos.web), NOT the App ID. Return URL: ${APP_ORIGIN}/api/v1/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
# Key ID of the "Sign in with Apple" key (.p8)
APPLE_KEY_ID=
# The .p8 contents: PKCS#8 PEM (newlines may be written as \n) or base64 of the whole file
APPLE_PRIVATE_KEY=
# Tests only: base URL of a fake Apple (default https://appleid.apple.com)
APPLE_API_BASE=
# 32-byte key (base64) for encrypting integration credentials at rest
CREDENTIALS_KEY=
# (also the key-encryption key that wraps the per-object keys of stored files — F-019)

# --- Encrypted object storage (card originals, profile media, room files, recordings) ---
# Default: local encrypted disk at ./.data/objects. Set OBJECT_STORAGE_BUCKET (or DRIVER=s3) for S3-compatible storage.
OBJECT_STORAGE_DRIVER=
OBJECT_STORAGE_LOCAL_DIR=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_PREFIX=
CARD_IMAGE_RETENTION_DAYS=365
RECORDING_RETENTION_DAYS=180
# --- Upload malware scan (F-172): optional clamd (INSTREAM over TCP) ---
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# 1 = reject uploads when the scanner is unavailable (fail closed)
CLAMAV_REQUIRED=
# --- Meeting transcription (F-082/F-083): google | whisper (empty = store recordings without STT) ---
STT_PROVIDER=
STT_LANGUAGES=ko-KR,en-US
STT_MAX_SPEAKERS=6
STT_TIMEOUT_MS=120000
GOOGLE_STT_PROJECT=
GOOGLE_STT_LOCATION=global
GOOGLE_STT_MODEL=long
GOOGLE_STT_RECOGNIZER=_
# one of: service-account JSON, OAuth access token, API key
GOOGLE_STT_CREDENTIALS_JSON=
GOOGLE_STT_ACCESS_TOKEN=
GOOGLE_STT_API_KEY=
GOOGLE_STT_ENDPOINT=
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
STT_LANGUAGE=


# --- Track B: communication, scheduling, CRM, push, webhooks (all optional) ---
# Web Push (F-110): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@linkos.app
# Microsoft identity platform app (Outlook contacts/calendar/mail, F-119); also used for Dynamics unless DYNAMICS_* is set
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Salesforce connected app (F-120)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0
# HubSpot public app (F-121). Scopes: crm.objects.contacts/companies/deals .read+.write (Contact/Company/Deal sync)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Dynamics 365 (F-122): Azure AD app with Dynamics CRM user_impersonation permission
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT=
# Outgoing webhooks (F-123): only for local development — allows http:// and private addresses
WEBHOOK_ALLOW_PRIVATE=
# PDF export font directory override (F-126) when node_modules/pretendard is not available at runtime
PDF_FONT_DIR=

# --- B2B SSO (F-008): OIDC + SAML 2.0 are configured per organization in the app (조직 설정), not via env ---
# Local development only: allow http:// OIDC issuers and SAML IdP SSO URLs. Never set in production.
SSO_ALLOW_HTTP_ISSUER=
