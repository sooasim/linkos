# PROPLUS 환경변수 — 운영 배포는 /etc/proplus/proplus.env (root:proplus 640)
#
# 이 파일은 **코드가 실제로 읽는 이름**만 담는다. 쓰이지 않는 변수를 적어 두면
# 운영자가 설정했다고 믿는데 아무 효과가 없는 상태가 된다(실제로 한 번 그랬다 —
# STORAGE_SIGNING_KEY 로 적혀 있었지만 코드는 STORAGE_SIGNING_SECRET 을 읽는다).
#
# 목록을 코드와 대조하려면:
#   grep -rhoE "process\.env\.[A-Z_0-9]+" proplus/services proplus/apps/web/src proplus/db | sed 's/process.env.//' | sort -u

# ─── 필수 ────────────────────────────────────────────────────────────────────

# PROPLUS 전용 DB. 이름이 둘인 이유: 한 셸에서 LINKOS 와 PROPLUS 를 함께 다룰 때
# DATABASE_URL 하나만 쓰면 **LINKOS DB 에 PROPLUS 마이그레이션을 붓는 사고**가 난다.
# lib/db.ts 는 PROPLUS_DATABASE_URL 을 먼저 보고, 없으면 DATABASE_URL 로 폴백한다.
PROPLUS_DATABASE_URL=postgres://proplus:proplus@localhost:5433/proplus
DATABASE_URL=

# 공개 주소. **CSRF origin 검사(P-188)의 기준**이라 실제 주소와 정확히 같아야 한다.
# 스킴까지 비교하므로 https 를 빼먹으면 모든 변경 요청이 403 이 된다.
APP_ORIGIN=http://localhost:4400

# 세션·토큰 서명용. 바꾸면 **기존 세션이 전부 끊긴다**(강제 로그아웃 수단).
#   openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# 리드 연락처 등 민감 필드 암호화 키 (AES-256-GCM). **32바이트 base64.**
# 바꾸면 기존 암호문을 복호화할 수 없다 — 교체하려면 재암호화 작업이 필요하다.
#   openssl rand -base64 32
FIELD_KEY=

PORT=4400

# ─── 저장소 (증거 원본) ──────────────────────────────────────────────────────

# 운영: /var/lib/proplus/storage. systemd 유닛의 ReadWritePaths 와 같아야 한다.
OBJECT_STORAGE_LOCAL_DIR=./.data/proplus-objects

# 서명 URL HMAC 키. 비면 AUTH_SECRET 으로 폴백하지만 **운영에서는 따로 둔다** —
# 세션 키와 분리해야 한쪽이 새도 다른 쪽이 버틴다.
#   openssl rand -base64 48
STORAGE_SIGNING_SECRET=

# 서명 URL 만료(초). 기본 60 — 증거 링크가 메신저에 붙여진 뒤에도 열리면 N-5 가 무의미해진다.
STORAGE_SIGNED_URL_TTL_SEC=
# 서명 URL 경로 접두사. 기본 /api/v1/files — 바꾸면 그 경로에 핸들러가 있어야 한다.
STORAGE_SIGNED_URL_PREFIX=

# ─── 개인정보 해시 솔트 (N-13) ───────────────────────────────────────────────
#
# 솔트가 없으면 IPv4 공간이 좁아 방문자 해시가 전수 대입으로 복원된다(보안정책 §3).
# 둘 다 비면 AUTH_SECRET 으로 폴백한다. 운영에서는 넣고 주기적으로 교체한다.
# 교체하면 그 시점 이후 방문자가 **새 사람으로 집계**된다(중복 제거가 끊긴다).
ANALYTICS_SALT=
VISITOR_SALT=

# ─── 메일 ────────────────────────────────────────────────────────────────────

# 비우면 메일을 보내지 않고 로그만 남긴다. 매직링크 로그인이 실제로 동작하려면 필요하다.
SMTP_URL=
MAIL_FROM=

# ─── 운영/개발 스위치 ────────────────────────────────────────────────────────

# 1 이면 메일 없이 즉시 세션을 발급한다. **운영에서는 반드시 비워 둔다** —
# 켜져 있으면 아무나 로그인할 수 있다. 검증용 임시 배포에서만 쓴다.
DEMO_LOGIN=

# 워커 폴링 주기(ms, 기본 5000) · 만료 예정 알림 기준일(기본 30)
WORKER_INTERVAL_MS=
PROPLUS_EXPIRY_NOTICE_DAYS=

# 배포 식별. deploy 스크립트가 revision.env 에 APP_REVISION 을 따로 쓴다.
APP_VERSION=
APP_REVISION=

# DB 풀 튜닝 (비우면 기본값: max 10, connect 5s, statement 15s, lock 10s)
DB_POOL_MAX=
DB_CONNECT_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=

# 테스트 전용. 운영에서 1 로 두면 rate limit 이 통째로 꺼진다(P-189 무력화).
RATE_LIMIT_DISABLED=

# ─── 시드 전용 ───────────────────────────────────────────────────────────────
PROPLUS_SEED_SLUG=
PROPLUS_SEED_EMAIL=
