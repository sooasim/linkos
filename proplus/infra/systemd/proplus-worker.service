[Unit]
# outbox_events 소비 + 만료 임박/만료 알림 (P-183·P-184, 기술백서 §7).
#
# 이 유닛이 멈추면 화면은 살아 있지만 메일 발송과 만료 알림이 지연된다.
# **공개 배지의 만료 자체는 지연되지 않는다** — 만료는 읽기 시점에 DB 뷰가 판정한다(N-9).
# 워커를 신뢰 경계에 두지 않는 것이 설계 의도다 (전략 §4.2).
Description=PROPLUS outbox/notification worker for proplus.linkos.com
Documentation=https://github.com/sooasim/linkos
After=network-online.target postgresql.service proplus-web.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=proplus
Group=proplus
WorkingDirectory=/var/www/proplus
EnvironmentFile=/etc/proplus/proplus.env
EnvironmentFile=-/etc/proplus/revision.env
# node_modules/.bin/tsx 는 /bin/sh 래퍼라 node 에 직접 넘기면 SyntaxError 가 난다.
# 실제 ESM 엔트리를 가리켜 래퍼(와 PATH 의 시스템 node v20)를 건너뛴다.
ExecStart=/opt/node24/bin/node node_modules/tsx/dist/cli.mjs proplus/services/api/src/worker.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proplus-worker

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# 보존기간 집행(증거 원본 삭제 — 데이터모델 §7-2)이 스토리지에 써야 한다.
ReadWritePaths=/var/lib/proplus

[Install]
WantedBy=multi-user.target
