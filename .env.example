# Copy to .env (never commit .env)
DATABASE_URL=postgres://linkos:linkos@localhost:5432/linkos
# Public origin used for exchange links (https in production)
APP_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. Used for session cookies/HMAC.
AUTH_SECRET=change-me-to-a-long-random-string
# Email OTP delivery. If unset in non-production, OTP codes are logged to the server console.
SMTP_URL=
MAIL_FROM="LINKOS <no-reply@linkos.app>"
# Google OAuth (Sign-in + People API sync). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key (base64) for encrypting integration credentials at rest
CREDENTIALS_KEY=

# --- Track B: communication, scheduling, CRM, push, webhooks (all optional) ---
# Web Push (F-110): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@linkos.app
# Microsoft identity platform app (Outlook contacts/calendar/mail, F-119); also used for Dynamics unless DYNAMICS_* is set
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Salesforce connected app (F-120)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0
# HubSpot public app (F-121)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Dynamics 365 (F-122): Azure AD app with Dynamics CRM user_impersonation permission
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT=
# Outgoing webhooks (F-123): only for local development — allows http:// and private addresses
WEBHOOK_ALLOW_PRIVATE=
# PDF export font directory override (F-126) when node_modules/pretendard is not available at runtime
PDF_FONT_DIR=
