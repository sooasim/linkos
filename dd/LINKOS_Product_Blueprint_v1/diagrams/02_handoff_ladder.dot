
digraph G {
 graph [rankdir=LR, bgcolor="white", fontname="Noto Sans CJK KR", nodesep=0.25, ranksep=0.3];
 node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=9, fillcolor="#F7F9FC", color="#44546A"];
 edge [fontname="Noto Sans CJK KR", fontsize=8, color="#596780"];
 S [label="공유 시작\n1회 탭", fillcolor="#E8F1FF"];
 A [label="1. 앱↔앱\nBLE 근접 세션\n상호 승인"];
 B [label="2. OS 공유\nAirDrop/Quick Share 등\n일회성 링크"];
